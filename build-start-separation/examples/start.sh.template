#!/usr/bin/env bash
# ==============================================================================
# Fast Production Runner Template (Bash / Linux / macOS)
# ==============================================================================
# Runs ONLY pre-compiled production artifacts (release binary + static preview):
#   1. Stops any previously running instance via ./stop.sh
#   2. Auto-invokes ./build.sh ONLY if production artifacts are missing
#   3. Launches Backend & Frontend and stores their PIDs in .pids
#   4. Performs 100ms readiness probing and streams prefixed logs
#   5. Supports both interactive mode (Ctrl+C invokes ./stop.sh) and
#      background daemon mode (--background) for external stop via ./stop.sh
# ==============================================================================

set -euo pipefail

BACKGROUND=0
BACKEND_PORT="${BACKEND_PORT:-8080}"
FRONTEND_PORT="${FRONTEND_PORT:-5173}"

for arg in "$@"; do
    case "$arg" in
        --background|-d) BACKGROUND=1 ;;
    esac
done

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$ROOT_DIR/.pids"
STOP_SCRIPT="$ROOT_DIR/stop.sh"
BUILD_SCRIPT="$ROOT_DIR/build.sh"
FRONTEND_DIR="$ROOT_DIR/frontend"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_INDEX="$FRONTEND_DIR/dist/index.html"

find_backend_bin() {
    find "$BACKEND_DIR/target/release" -maxdepth 1 -type f -executable \
        ! -name "*.d" ! -name "*.so" ! -name "build-script-*" 2>/dev/null | head -n 1
}

# 1. Stop any previously running instance via ./stop.sh
if [ -f "$STOP_SCRIPT" ]; then
    bash "$STOP_SCRIPT" --quiet || true
fi

# 2. Verify production artifacts exist (auto-build only if missing)
BACKEND_BIN="$(find_backend_bin || true)"
if [ ! -f "$FRONTEND_INDEX" ] || [ -z "$BACKEND_BIN" ] || [ ! -f "$BACKEND_BIN" ]; then
    echo "Production artifacts missing. Running ./build.sh first..."
    bash "$BUILD_SCRIPT"
    BACKEND_BIN="$(find_backend_bin)"
fi

echo "Starting Application in 100% Optimized Production Mode..."

if [ "$BACKGROUND" -eq 1 ]; then
    (cd "$BACKEND_DIR" && nohup "$BACKEND_BIN" > "$ROOT_DIR/.backend.log" 2>&1 &)
    sleep 0.1
    BACKEND_PID=$(pgrep -f "$BACKEND_BIN" | head -n 1 || true)

    (cd "$FRONTEND_DIR" && nohup pnpm run preview -- --port "$FRONTEND_PORT" --host > "$ROOT_DIR/.frontend.log" 2>&1 &)
    sleep 0.2
    FRONTEND_PID=$(lsof -ti :"$FRONTEND_PORT" 2>/dev/null | head -n 1 || true)

    cat > "$PID_FILE" <<EOF
BACKEND_PID=$BACKEND_PID
FRONTEND_PID=$FRONTEND_PID
BACKEND_PORT=$BACKEND_PORT
FRONTEND_PORT=$FRONTEND_PORT
STARTED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
EOF
    echo "  [PID State] Stored PIDs in $PID_FILE (Backend: $BACKEND_PID, Frontend: $FRONTEND_PID)"
    echo "Application running in background! Open: http://localhost:$FRONTEND_PORT"
    echo "Run ./stop.sh to stop all services."
    exit 0
fi

# Foreground supervised execution
(cd "$BACKEND_DIR" && exec "$BACKEND_BIN") 2>&1 | sed 's/^/[Backend] /' &
BACKEND_PID=$!

(cd "$FRONTEND_DIR" && exec pnpm run preview -- --port "$FRONTEND_PORT" --host) 2>&1 | sed 's/^/[Frontend] /' &
FRONTEND_PID=$!

# Persist PIDs immediately so ./stop.sh can stop them from any terminal
cat > "$PID_FILE" <<EOF
BACKEND_PID=$BACKEND_PID
FRONTEND_PID=$FRONTEND_PID
BACKEND_PORT=$BACKEND_PORT
FRONTEND_PORT=$FRONTEND_PORT
STARTED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
EOF

echo "  [PID State] Stored PIDs in $PID_FILE (Backend: $BACKEND_PID, Frontend: $FRONTEND_PID)"

cleanup() {
    echo ""
    echo "Shutting down services via ./stop.sh..."
    if [ -f "$STOP_SCRIPT" ]; then
        bash "$STOP_SCRIPT" || true
    fi
}
trap cleanup EXIT INT TERM

# Fast 100ms readiness probing
for _ in $(seq 1 50); do
    if curl -fsS "http://127.0.0.1:$FRONTEND_PORT" >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done

echo ""
echo "Application is ready! Open http://localhost:$FRONTEND_PORT"
echo "Press Ctrl+C (or run ./stop.sh in another terminal) to stop both services."
echo "Backend PID: $BACKEND_PID | Frontend PID: $FRONTEND_PID"
echo ""

wait
