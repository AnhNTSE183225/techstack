# ==============================================================================
# Fast Production Runner Template (PowerShell / Windows)
# ==============================================================================
# Runs ONLY pre-compiled production artifacts (release binary + static preview):
#   1. Cleans up any existing running instance via .\stop.ps1
#   2. Auto-invokes .\build.ps1 ONLY if production artifacts are missing
#   3. Launches Backend & Frontend and persists their PIDs to .pids
#   4. Performs 100ms readiness probing and streams colorized logs
#   5. Supports both interactive mode (Ctrl+C invokes .\stop.ps1) and
#      background daemon mode (-Background) for external stop via .\stop.ps1
# ==============================================================================

param(
    [switch]$Background,
    [int]$BackendPort = 8080,
    [int]$FrontendPort = 5173
)

$ErrorActionPreference = "Stop"
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$OutputEncoding = [System.Text.Encoding]::UTF8

$root = Split-Path -Parent $MyInvocation.MyCommand.Path
$pidFile = Join-Path $root ".pids"
$stopScript = Join-Path $root "stop.ps1"
$buildScript = Join-Path $root "build.ps1"
$frontendDir = Join-Path $root "frontend"
$backendDir = Join-Path $root "backend"

function Get-NpmExecutable {
    $pnpm = Get-Command pnpm.cmd -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($pnpm) { return $pnpm.Source }
    $npm = Get-Command npm.cmd -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($npm) { return $npm.Source }
    throw "Neither pnpm nor npm was found in PATH. Run .\build.ps1 first."
}

function Find-BackendReleaseExe {
    $candidates = Get-ChildItem (Join-Path $backendDir "target\release\*.exe") -File -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -notmatch '^build-script-' }
    if ($candidates) { return ($candidates | Select-Object -First 1).FullName }
    return $null
}

function Ensure-BuildArtifacts {
    $frontendDist = Join-Path $frontendDir "dist\index.html"
    $backendExe = Find-BackendReleaseExe

    if ((-not (Test-Path $frontendDist)) -or (-not $backendExe)) {
        Write-Host "Production artifacts are missing. Running .\build.ps1 first..." -ForegroundColor Yellow
        & $buildScript
        if ($LASTEXITCODE -ne 0) {
            throw "Build script failed. Cannot start application."
        }
    }
}

function Save-PidFile {
    param(
        [int]$BackendPid,
        [int]$FrontendPid,
        [int]$BackPort,
        [int]$FrontPort
    )
    $payload = [ordered]@{
        backend_pid   = $BackendPid
        frontend_pid  = $FrontendPid
        backend_port  = $BackPort
        frontend_port = $FrontPort
        started_at    = (Get-Date).ToString("o")
        workspace     = $root
    }
    $payload | ConvertTo-Json | Set-Content -Path $pidFile -Encoding UTF8
    Write-Host "  [PID State] Stored PIDs in $pidFile (Backend: $BackendPid, Frontend: $FrontendPid)" -ForegroundColor DarkGray
}

function Start-ManagedProcess {
    param(
        [string]$Name,
        [string]$Prefix,
        [string]$Color,
        [string]$WorkingDirectory,
        [string]$FileName,
        [string]$Arguments
    )

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $FileName
    $psi.Arguments = $Arguments
    $psi.WorkingDirectory = $WorkingDirectory
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $psi.CreateNoWindow = $true

    $process = New-Object System.Diagnostics.Process
    $process.StartInfo = $psi
    $process.EnableRaisingEvents = $true

    if (-not $process.Start()) {
        throw "Failed to start $Name"
    }

    $outEvent = Register-ObjectEvent -InputObject $process -EventName OutputDataReceived -Action {
        if ($EventArgs.Data) {
            Write-Host "[$($Event.MessageData.Prefix)] $($EventArgs.Data)" -ForegroundColor $Event.MessageData.Color
        }
    } -MessageData @{ Prefix = $Prefix; Color = $Color }

    $errEvent = Register-ObjectEvent -InputObject $process -EventName ErrorDataReceived -Action {
        if ($EventArgs.Data) {
            Write-Host "[$($Event.MessageData.Prefix)] $($EventArgs.Data)" -ForegroundColor Red
        }
    } -MessageData @{ Prefix = $Prefix; Color = $Color }

    $process.BeginOutputReadLine()
    $process.BeginErrorReadLine()

    return [PSCustomObject]@{
        Name        = $Name
        Pid         = $process.Id
        Process     = $process
        OutputEvent = $outEvent
        ErrorEvent  = $errEvent
    }
}

function Test-ProcessRunning {
    param([int]$ProcessId)
    if (-not $ProcessId) { return $false }
    $existing = Get-Process -Id $ProcessId -ErrorAction SilentlyContinue
    return $null -ne $existing
}

# 1. Stop any previously running instance via stop.ps1
if (Test-Path $stopScript) {
    & $stopScript -Quiet
}

# 2. Verify production artifacts exist (auto-build only if missing)
Ensure-BuildArtifacts

$npmExecutable = Get-NpmExecutable
$backendExe = Find-BackendReleaseExe

Write-Host "Starting Application in 100% Optimized Production Mode..." -ForegroundColor Green

if ($Background) {
    $backProc = Start-Process -FilePath $backendExe -WorkingDirectory $backendDir -WindowStyle Hidden -PassThru
    $frontProc = Start-Process -FilePath $npmExecutable -ArgumentList "run preview -- --port $FrontendPort --host" -WorkingDirectory $frontendDir -WindowStyle Hidden -PassThru

    Save-PidFile -BackendPid $backProc.Id -FrontendPid $frontProc.Id -BackPort $BackendPort -FrontPort $FrontendPort

    for ($i = 0; $i -lt 50; $i++) {
        Start-Sleep -Milliseconds 100
        try {
            $frontCheck = Invoke-WebRequest -Uri "http://127.0.0.1:$FrontendPort" -UseBasicParsing -TimeoutSec 1 -ErrorAction SilentlyContinue
            if ($frontCheck -and $frontCheck.StatusCode -eq 200) { break }
        } catch {}
    }

    Write-Host "Application running in background! Open: http://localhost:$FrontendPort" -ForegroundColor Cyan
    Write-Host "Run .\stop.ps1 to stop all services." -ForegroundColor Yellow
    exit 0
}

$backend = $null
$frontend = $null
$script:shutdownRequested = $false

try {
    trap [System.Management.Automation.PipelineStoppedException] {
        $script:shutdownRequested = $true
        Write-Host "`nCtrl+C detected. Stopping services via PID tracker..." -ForegroundColor Yellow
        continue
    }

    $backend = Start-ManagedProcess `
        -Name "Backend" `
        -Prefix "Backend" `
        -Color "Cyan" `
        -WorkingDirectory $backendDir `
        -FileName $backendExe `
        -Arguments ""

    $frontend = Start-ManagedProcess `
        -Name "Frontend" `
        -Prefix "Frontend" `
        -Color "Magenta" `
        -WorkingDirectory $frontendDir `
        -FileName $npmExecutable `
        -Arguments "run preview -- --port $FrontendPort --host"

    # Persist PIDs immediately so .\stop.ps1 can stop them from any terminal
    Save-PidFile -BackendPid $backend.Pid -FrontendPid $frontend.Pid -BackPort $BackendPort -FrontPort $FrontendPort

    $launchUrl = "http://localhost:$FrontendPort"

    # Fast 100ms readiness probing
    for ($i = 0; $i -lt 50; $i++) {
        Start-Sleep -Milliseconds 100
        try {
            $frontCheck = Invoke-WebRequest -Uri "http://127.0.0.1:$FrontendPort" -UseBasicParsing -TimeoutSec 1 -ErrorAction SilentlyContinue
            if ($frontCheck -and $frontCheck.StatusCode -eq 200) {
                break
            }
        } catch {}
    }

    Write-Host ""
    Write-Host "Application is ready! Ctrl+Click to open:" -ForegroundColor Green
    Write-Host "  Local:     $launchUrl" -ForegroundColor Cyan
    $tsIp = (Get-NetIPAddress -InterfaceAlias "*Tailscale*" -AddressFamily IPv4 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty IPAddress -First 1)
    if ($tsIp) {
        Write-Host "  Tailscale: $($launchUrl -replace 'localhost', $tsIp)" -ForegroundColor Cyan
    }
    Write-Host ""
    Write-Host "Press Ctrl+C (or run .\stop.ps1 in another terminal) to stop services." -ForegroundColor Yellow
    Write-Host "Backend PID: $($backend.Pid) | Frontend PID: $($frontend.Pid)" -ForegroundColor DarkGray

    while (-not $script:shutdownRequested) {
        if (-not (Test-ProcessRunning -ProcessId $backend.Pid)) {
            Write-Host "Backend process (PID $($backend.Pid)) terminated." -ForegroundColor Red
            break
        }
        if (-not (Test-ProcessRunning -ProcessId $frontend.Pid)) {
            Write-Host "Frontend process (PID $($frontend.Pid)) terminated." -ForegroundColor Red
            break
        }
        Start-Sleep -Milliseconds 250
    }
} finally {
    if ($backend -and $backend.OutputEvent) { Unregister-Event -SubscriptionId $backend.OutputEvent.Id -ErrorAction SilentlyContinue }
    if ($backend -and $backend.ErrorEvent)  { Unregister-Event -SubscriptionId $backend.ErrorEvent.Id -ErrorAction SilentlyContinue }
    if ($frontend -and $frontend.OutputEvent) { Unregister-Event -SubscriptionId $frontend.OutputEvent.Id -ErrorAction SilentlyContinue }
    if ($frontend -and $frontend.ErrorEvent)  { Unregister-Event -SubscriptionId $frontend.ErrorEvent.Id -ErrorAction SilentlyContinue }

    if (Test-Path $stopScript) {
        & $stopScript
    }
}
